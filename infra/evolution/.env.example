# Domínio que aponta para o IP da VPS (registro A no DNS), ex.: whatsapp.suaclinica.com.br
DOMINIO=whatsapp.suaclinica.com.br
# Chave mestra da Evolution (gere uma longa e aleatória: openssl rand -hex 32)
AUTHENTICATION_API_KEY=troque-por-uma-chave-longa
# Senha do banco interno da Evolution (openssl rand -hex 16)
POSTGRES_PASSWORD=troque-esta-senha
